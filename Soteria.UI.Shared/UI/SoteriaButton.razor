<button type="@Type"
        class="soteria-button @ColorClass @(FullWidth ? "btn-full" : "")"
        @onclick="OnClick"
        disabled="@IsDisabled">
    @Text
</button>

@code {
    [Parameter] public string Text { get; set; } = "Botão";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool FullWidth { get; set; } = false; 
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string Color { get; set; } = "blue";

    private string ColorClass => Color.ToLower() switch
    {
        "yellow" => "btn-yellow",
        "blue" => "btn-blue",
        _ => "btn-blue"
    };
}