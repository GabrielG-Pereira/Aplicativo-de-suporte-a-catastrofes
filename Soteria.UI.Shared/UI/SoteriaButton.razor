<button type="@Type" class="soteria-button @ColorClass" @onclick="OnClick" disabled="@IsDisabled">
    @Text
</button>

@code {
    [Parameter] public string Text { get; set; } = "Botão";
    [Parameter] public string Type { get; set; } = "button"; // pode ser 'submit' ou 'button'
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string Color { get; set; } = "blue";


    // Lógica para definir a classe CSS baseada na cor informada
    private string ColorClass => Color.ToLower() switch
    {
        "yellow" => "btn-yellow",
        "blue" => "btn-blue",
        _ => "btn-blue"
    };
}