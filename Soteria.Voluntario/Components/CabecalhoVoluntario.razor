@inject NavigationManager NavManager

<header class="cabecalho-voluntario">

    @if (MostrarAvatar)
    {
        <div class="avatar-circulo" @onclick="IrParaPerfil">
            <span class="avatar-letra">@LetraAvatar</span>
        </div>
    }

    <div class="cabecalho-icones">
        <button class="icone-btn" @onclick="AbrirEventos" aria-label="Notificações">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#002F52"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </button>

        <button class="icone-btn" @onclick="IrParaPerfil" aria-label="Perfil do usuário">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#002F52"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
        </button>
    </div>

</header>

@code {
    /// <summary>Exibe o avatar com a inicial do nome (usar nas telas internas)</summary>
    [Parameter] public bool MostrarAvatar { get; set; } = false;

    /// <summary>Letra exibida no avatar — passe a inicial do nome do voluntário logado</summary>
    [Parameter] public string LetraAvatar { get; set; } = "V";

    private void AbrirEventos()    => NavManager.NavigateTo("/eventos");
    private void IrParaPerfil()    => NavManager.NavigateTo("/perfil");
}
