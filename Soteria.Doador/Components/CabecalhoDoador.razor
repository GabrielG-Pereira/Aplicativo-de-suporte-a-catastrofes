@inject NavigationManager NavManager

<header class="cabecalho-voluntario">
    <div class="cabecalho-icones">
        <button class="icone-btn" @onclick="IrParaHome" aria-label="Ir para o Início">
            <!-- Ícone de Home (Casa) -->
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#002F52"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
        </button>
    </div>
</header>

@code {
    // Nome do método alterado para refletir a nova função
    private void IrParaHome() => NavManager.NavigateTo("/");
}
