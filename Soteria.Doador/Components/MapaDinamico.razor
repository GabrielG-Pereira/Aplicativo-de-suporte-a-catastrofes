@inject IJSRuntime JSRuntime

<div class="container-mapa">
    <!-- O id "meuMapa" é obrigatório para o Leaflet saber onde desenhar -->
    <div id="meuMapa" class="estilo-mapa"></div>
</div>

@code {
    // Essa é a simulação dos dados que virão do seu Backend
    private List<LocalizacaoBackend> _pontosDoBackend = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Inicia o mapa centralizado em uma coordenada (Ex: São Paulo)
            await JSRuntime.InvokeVoidAsync("mapaInterop.iniciarMapa", "meuMapa", -23.5505, -46.6333);

            // 2. Chama o Backend para pegar os locais (Simulado aqui)
            await CarregarDadosDoBackend();

            // 3. Manda a lista para o JavaScript desenhar os pinos
            await JSRuntime.InvokeVoidAsync("mapaInterop.adicionarPinos", _pontosDoBackend);
        }
    }

    private async Task CarregarDadosDoBackend()
    {
        // Aqui na vida real você usaria: await httpClient.GetFromJsonAsync<...>("sua-api/locais");
        
        // Dados fictícios simulando a resposta do banco de dados:
        _pontosDoBackend = new List<LocalizacaoBackend>
        {
            new() { Nome = "Abrigo Principal", Tipo = "Fixo", Latitude = -23.5505, Longitude = -46.6333 },
            new() { Nome = "Ponto de Arrecadação", Tipo = "Temporário", Latitude = -23.5600, Longitude = -46.6400 }
        };
    }

    // A classe que representa o pacote de dados do banco
    public class LocalizacaoBackend
    {
        public string Nome { get; set; }
        public string Tipo { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }
}