@using Soteria.UI.Shared.UI
@inject NavigationManager NavManager

<div class="cartao-local-doacao">
    <h3 class="titulo-abrigo">@Nome</h3>
    
    <div class="info-linha">
        <div class="icone-fundo">
            <img src="Imagens/IconeLocalizacao.svg" alt="Icone Localização" />
        </div>
        <div class="textos">
            <span class="rotulo">Distância</span>
            <span class="valor">@Distancia</span>
        </div>
    </div>

    <div class="info-linha">
        <div class="icone-fundo">
            <img src="Imagens/IconeTipo.svg" alt="Icone Tipo" />
        </div>
        <div class="textos">
            <span class="rotulo">Tipo</span>
            <span class="valor">@Tipo</span>
        </div>
    </div>

    <SoteriaButton Text="Ver detalhes" OnClick="AbrirPaginaDemandas" Color="yellow" FullWidth="true" />
</div>

@code {
    // Parâmetros para integração com o backend
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Nome { get; set; } = "Nome do Local";
    [Parameter] public string Distancia { get; set; } = "0km";
    [Parameter] public string Tipo { get; set; } = "Fixo";

    void AbrirPaginaDemandas()
    {
        // Ao navegar, passamos o ID para o backend saber qual ponto carregar
        NavManager.NavigateTo($"/demandas/{Id}");
    }
}