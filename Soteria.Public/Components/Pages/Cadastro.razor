
@page "/cadastro"
@rendermode InteractiveServer

<div class="page-container">
    <div class="form-card">
        <SoteriaTitle Text="CADASTRO DE VOLUNTÁRIO" Size="medium" />
        <SoteriaInput Label="Nome completo" />
        <SoteriaInput Label="Email" Type="email" />
        <SoteriaInput Label="Telefone" Type="tel" />
        <SoteriaInput Label="Senha" Type="password" />
        <SoteriaInput Label="Confirmar Senha" />
        <SoteriaInput Label="Endereço" />
        <SoteriaSelect Label="Especialidade" Options="especialidades" />
        <SoteriaSelect Label="Você está disponível para atuar agora?" Options="disponibilidade" />
        <SoteriaButton Text="Cadastrar" Color="yellow" FullWidth="true"  OnClick="ProcessarCadastro" />
        
    </div>
</div>

@code {
    private List<string> especialidades = new() { "Médico", "Enfermeiro", "Motorista", "Resgate" };
    private List<string> disponibilidade = new() { "Sim", "Não" };

    private void ProcessarCadastro()
    {
        Console.WriteLine("BOTAO CLICADO");
    }
   
}
