@page "/demandas/{PontoEventoId:guid}"
@rendermode InteractiveServer
@using Soteria.Sql
@using Soteria.Sql.Models
@inject NavigationManager Navigation

<div class="page-container">
    <div class="content-wrapper">
        
        <div class="page-header">
            <SoteriaTitle Text="DEMANDAS DO PONTO" />
            <SoteriaButton Text="Adicionar" Color="blue" OnClick="NavegarParaAdicionar" />
        </div>

        <SoteriaTable Headers="@(new List<string> { "Demanda", "ID", "Descrição", "Status", "Ações" })">
            @if (listaDemandas == null)
            {
                <tr><td colspan="5">Carregando demandas...</td></tr>
            }
            else if (listaDemandas.Count == 0)
            {
                <tr><td colspan="5">Nenhuma demanda registrada para este ponto.</td></tr>
            }
            else
            {
                @foreach (var item in listaDemandas)
                {
                    <tr>
                        <td>@item.CategoriaNome</td>
                        <td>@item.Id.ToString().Substring(0, 8)...</td>
                        <td>@item.Descricao</td>
                        <td>
                            <span class="badge-status">@item.Status</span>
                        </td>
                        <td>
                            <SoteriaButton Text="Ver mais"
                                           Color="yellow"
                                           OnClick="@(() => NavegarParaDetalhes(item.Id))" />
                        </td>
                    </tr>
                }
            }
        </SoteriaTable>

    </div>
</div>

@code {
    [Parameter] public Guid PontoEventoId { get; set; }
    private List<DemandaLista>? listaDemandas;

    protected override void OnInitialized()
    {
        CarregarDemandas();
    }

    private void CarregarDemandas()
    {
        listaDemandas = Sql.ListarDemandasPorPonto(PontoEventoId);
    }

    private void NavegarParaAdicionar()
    {
        // Passamos o ID do ponto para saber onde adicionar a nova demanda
        Navigation.NavigateTo($"/adicionar-demanda/{PontoEventoId}");
    }

    private void NavegarParaDetalhes(Guid idDemanda)
    {
        Navigation.NavigateTo($"/alterar-demanda/{idDemanda}");
    }
}