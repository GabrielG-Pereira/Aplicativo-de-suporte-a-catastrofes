@page "/alterar-demanda/{Id:guid}"
@using Soteria.Sql
@using Soteria.Sql.Models
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="page-container">
    <div class="page-header">
        <SoteriaTitle Text="INFORMAÇÕES DA DEMANDA" />
        <div class="header-actions">
            <SoteriaButton Color="blue" Text="Editar" OnClick="HabilitarEdicao" />
            <SoteriaButton Color="blue" Text="Apagar" OnClick="ConfirmarExclusao" />
        </div>
    </div>

    @if (demanda == null)
    {
        <p>Carregando dados da demanda...</p>
    }
    else
    {
        <SoteriaSelect Label="Categoria"
                       Options="@listaCategorias.Select(c => c.Nome).ToList()"
                       @bind-Value="demanda.Categoria"
                       IsDisabled="isReadOnly" />

        <SoteriaInput Label="Descrição"
                      @bind-Value="demanda.Descricao"
                      Description="true"
                      IsDisabled="isReadOnly" />
        
        <div class="page-inputs" style="display: flex; gap: 20px; margin-top: 15px;">
            <SoteriaSelect Label="Status"
                           Options="statusOptions"
                           @bind-Value="demanda.Status"
                           IsDisabled="isReadOnly" />
            
            @* Se você salvou a quantidade dentro da descrição, este campo pode ser informativo ou omitido *@
            <SoteriaInput Label="Quantidade" @bind-Value="quantidadeTemporaria" IsDisabled="isReadOnly" />
        </div>

        <div class="form-footer" style="margin-top: 30px; display: flex; gap: 10px;">
            <SoteriaButton Text="Salvar Alterações" Color="yellow" OnClick="Salvar" IsDisabled="isReadOnly" FullWidth="true" />
            <SoteriaButton Text="Voltar" Color="outline" OnClick="Voltar" FullWidth="true" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private DemandaModel? demanda;
    private List<CategoriaDemanda> listaCategorias = new();
    private bool isReadOnly = true;
    private string quantidadeTemporaria = ""; // Auxiliar

    // Opções baseadas no CHECK CONSTRAINT do SQL (Crítico, Médio, Estável)
    private List<string> statusOptions = new() { "Crítico", "Médio", "Estável" };

    protected override void OnInitialized()
    {
        listaCategorias = Sql.ListarCategoriasDemanda();
        demanda = Sql.BuscarDemandaPorId(Id);

        if (demanda == null)
        {
            Navigation.NavigateTo("/demandas");
        }
    }

    private void HabilitarEdicao() => isReadOnly = false;

    private void Salvar()
    {
        if (demanda != null)
        {
            // Busca o GUID da categoria baseado no nome selecionado
            var catObj = listaCategorias.FirstOrDefault(c => c.Nome == demanda.Categoria);

            if (catObj.Id != Guid.Empty)
            {
                bool sucesso = Sql.AtualizarDemanda(Id, catObj.Id, demanda.Descricao, demanda.Status);
                if (sucesso)
                {
                    isReadOnly = true;
                }
            }
        }
    }

    private void ConfirmarExclusao()
    {
        if (demanda != null)
        {
            bool deletado = Sql.DeletarDemanda(Id);
            if (deletado)
            {
                Navigation.NavigateTo($"/demandas/{demanda.IdPontoEvento}");
            }
        }
    }

    private void Voltar()
    {
        if (demanda != null)
            Navigation.NavigateTo($"/demandas/{demanda.IdPontoEvento}");
        else
            Navigation.NavigateTo("/eventos-ativos");
    }

    public class DemandaModel
    {
        public Guid Id { get; set; }
        public Guid IdPontoEvento { get; set; }
        public string Categoria { get; set; } = "";
        public string Descricao { get; set; } = "";
        public string Status { get; set; } = "";
    }
}