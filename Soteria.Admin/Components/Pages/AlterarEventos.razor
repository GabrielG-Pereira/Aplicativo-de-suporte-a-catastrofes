@page "/alterar-evento/{Id:guid}"
@using Soteria.Sql
@using Soteria.Sql.Models
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="page-container">
    <div class="page-header">
        <SoteriaTitle Text="INFORMAÇÕES DO EVENTO" />
        <div class="header-actions">
            <SoteriaButton Color="blue" Text="Editar" OnClick="HabilitarEdicao" />
            <SoteriaButton Color="blue" Text="Apagar" OnClick="ConfirmarExclusao" />
        </div>
    </div>

    @if (evento == null)
    {
        <p>Carregando dados do evento...</p>
    }
    else
    {
        <SoteriaInput Label="Título do evento" @bind-Value="evento.Nome" IsDisabled="isReadOnly" />
        @* Como o banco não tem coluna endereço separada, usamos a descrição *@
        <SoteriaInput Label="Descrição / Detalhes" @bind-Value="evento.Descricao" Description="true" IsDisabled="isReadOnly" />
        
        <SoteriaSelect Label="Status" Options="statusOptions" @bind-Value="evento.Status" IsDisabled="isReadOnly" />

        <div class="form-footer" style="margin-top: 20px; display: flex; gap: 10px;">
            <SoteriaButton Text="Salvar Alterações" Color="yellow" OnClick="Salvar" IsDisabled="isReadOnly" FullWidth="true" />
            <SoteriaButton Text="Voltar" Color="outline" OnClick="Voltar" FullWidth="true" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private EventoLista? evento;
    private bool isReadOnly = true;
    private List<string> statusOptions = new() { "Ativo", "Encerrado", "Alerta Crítico" };

    protected override void OnInitialized()
    {
        // Busca o evento real do banco usando o ID da URL
        evento = Sql.BuscarEventoPorIdSoteriaAdmin(Id);
        
        if (evento == null)
        {
            Navigation.NavigateTo("/eventos-ativos");
        }
    }

    private void HabilitarEdicao() => isReadOnly = false;

    private void Salvar()
    {
        if (evento != null)
        {
            bool sucesso = Sql.AtualizarEvento(evento.Id, evento.Nome, evento.Descricao, evento.Status);
            if (sucesso)
            {
                isReadOnly = true;
                // Opcional: Feedback de sucesso
            }
        }
    }

    private void ConfirmarExclusao()
    {
        if (evento != null)
        {
            bool deletado = Sql.DeletarEvento(evento.Id);
            if (deletado)
            {
                Navigation.NavigateTo("/eventos-ativos");
            }
        }
    }

    private void Voltar() => Navigation.NavigateTo("/eventos-ativos");
}