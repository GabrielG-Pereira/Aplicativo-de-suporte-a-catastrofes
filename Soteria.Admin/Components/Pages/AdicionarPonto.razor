@page "/adicionar-ponto"
@using Soteria.Sql
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="page-container">
    <div class="page-header"><SoteriaTitle Text="ADICIONAR PONTO" /></div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="alert @(sucesso ? "alert-success" : "alert-danger")">@mensagem</div>
    }

    <SoteriaInput Label="Nome do ponto" @bind-Value="nome" />
    <SoteriaInput Label="Endereço" @bind-Value="endereco" />
    <SoteriaInput Label="Contato" @bind-Value="contato" />
    
    <div class="page-inputs" style="display: flex; gap: 20px; margin-top: 15px;">
        <SoteriaSelect Label="Temporário"
                       Options="@(new List<string> { "Sim", "Não" })"
                       @bind-Value="temporarioTexto" />
        
        <SoteriaSelect Label="Gestor Responsável"
                       Options="@(new List<string> { "Gestor 1", "Gestor 2" })"
                       @bind-Value="gestorResponsavel" />
    </div>

    <div class="button" style="margin-top: 30px; display: flex; gap: 10px;">
        <SoteriaButton Text="Adicionar" Color="yellow" FullWidth="true" OnClick="ProcessarAdicionar" />
        <SoteriaButton Text="Voltar" Color="outline" FullWidth="true" OnClick="Voltar" />
    </div>
</div>

@code {
    private string nome = "";
    private string endereco = "";
    private string contato = "";
    private string temporarioTexto = "Não";
    private string gestorResponsavel = "Gestor 1";

    private string mensagem = "";
    private bool sucesso = false;

    private void ProcessarAdicionar()
    {
        // Validação básica
        if (string.IsNullOrWhiteSpace(nome) || string.IsNullOrWhiteSpace(endereco))
        {
            mensagem = "Nome e Endereço são obrigatórios.";
            sucesso = false;
            return;
        }

        // Converte o texto do Select para booleano
        bool ehTemporario = (temporarioTexto == "Sim");

        bool resultado = Sql.InserirPontoColeta(nome, endereco, contato, ehTemporario);

        if (resultado)
        {
            Navigation.NavigateTo("/pontos");
        }
        else
        {
            mensagem = "Erro ao cadastrar ponto de coleta no banco de dados.";
            sucesso = false;
        }
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/pontos");
    }
}