@page "/adicionar-demanda/{PontoEventoId:guid}"
@using Soteria.Sql
@using Soteria.Sql.Models
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="page-container">
    <div class="page-header"><SoteriaTitle Text="ADICIONAR DEMANDA" /></div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="alert alert-danger">@mensagem</div>
    }

    <SoteriaSelect Label="Categoria"
                   Options="@categorias.Select(c => c.Nome).ToList()"
                   @bind-Value="categoriaSelecionada" />

    <SoteriaInput Label="Descrição" Type="textarea" @bind-Value="descricao" />
    
    <div class="page-inputs" style="display: flex; gap: 20px; margin-top: 15px;">
        <SoteriaSelect Label="Status" Options="statusOptions" @bind-Value="statusSelecionado" />
        <SoteriaInput Label="Quantidade (ex: 10kg, 5 pacotes)" @bind-Value="quantidade" />
    </div>
    
    <div class="button" style="margin-top: 30px; display: flex; gap: 10px;">
        <SoteriaButton Text="Adicionar" Color="yellow" FullWidth="true" OnClick="SalvarDemanda" />
        <SoteriaButton Text="Voltar" Color="outline" FullWidth="true" OnClick="Voltar" />
    </div>
</div>

@code {
    [Parameter] public Guid PontoEventoId { get; set; }

    private List<CategoriaDemanda> categorias = new();
    private List<string> statusOptions = new() { "Crítico", "Médio", "Es    tável" };

    private string categoriaSelecionada = "";
    private string descricao = "";
    private string statusSelecionado = "Estável";
    private string quantidade = "";
    private string mensagem = "";

    protected override void OnInitialized()
    {
        // Carrega as categorias do banco
        categorias = Sql.ListarCategoriasDemanda();
        if (categorias.Any()) categoriaSelecionada = categorias.First().Nome;
    }

    private void SalvarDemanda()
    {
        if (string.IsNullOrWhiteSpace(categoriaSelecionada))
        {
            mensagem = "Selecione uma categoria.";
            return;
        }

        // Busca o Guid da categoria pelo nome selecionado no Select
        var catObj = categorias.FirstOrDefault(c => c.Nome == categoriaSelecionada);
        
        if (catObj.Id != Guid.Empty)
        {
            // Unificando quantidade e descrição já que o banco não tem campo 'quantidade'
            string descCompleta = $"Qtd: {quantidade} | {descricao}";

            bool sucesso = Sql.InserirDemanda(PontoEventoId, catObj.Id, descCompleta, statusSelecionado);

            if (sucesso)
            {
                Voltar();
            }
            else
            {
                mensagem = "Erro ao salvar no banco de dados.";
            }
        }
    }

    private void Voltar()
    {
        Navigation.NavigateTo($"/demandas/{PontoEventoId}");
    }
}